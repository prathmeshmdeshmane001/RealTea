# ==============================================================================
# RealTea Studio - Environment Configuration Template
# Copy this file to .env and insert your real API credentials.
# NEVER commit your actual .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Providers
# ------------------------------------------------------------------------------

# Google Gemini API Key (Recommended default for RealTea)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required for OpenAI embeddings and GPT models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key (Optional for DeepSeek Chat model)
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ------------------------------------------------------------------------------
# 2. External Search Augmentation (CRAG Web Fallback)
# ------------------------------------------------------------------------------

# Tavily Search API Key (Required for external web search when documents are incomplete)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 3. Server Runtime Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
